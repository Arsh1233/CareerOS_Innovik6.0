# CareerOS backend environment.
# Copy to `backend/.env` and fill in real values. Never commit `.env`.
# Secrets here must NEVER be exposed to the frontend or prefixed with VITE_.

APP_ENV=development
LOG_LEVEL=INFO

# Comma-separated list of allowed frontend origins (no wildcards).
CORS_ALLOWED_ORIGINS=http://localhost:8443

# ── Supabase (Auth + PostgreSQL + Storage) ────────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-public-key>
# Server-side only. Grants privileged admin access — never ship to the browser.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# Only needed for legacy projects that sign JWTs with a shared HS256 secret.
# Leave empty for projects using asymmetric (ES256/RS256) JWKS signing keys.
SUPABASE_JWT_SECRET=

# Postgres connection string used by the API.
# The role must be able to `SET ROLE authenticated`; queries then run through
# Supabase RLS using the verified JWT claims. Use the Supabase pooler URL.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<host>:6543/postgres
DATABASE_POOL_MAX_SIZE=10

# ── AI provider (Gemini) — used from later phases ─────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=

# ── Groq — structured roadmap generation (Phase 06) ───────────────────────
# Without a key, POST /roadmap/get-roadmap returns 503 ai_not_configured
# instead of a fabricated plan.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_SECONDS=45

# ── Vector search (Qdrant) — used from later phases ───────────────────────
QDRANT_URL=
QDRANT_API_KEY=

# ── Voice (ElevenLabs) — used from later phases ───────────────────────────
ELEVENLABS_API_KEY=

# ── Workflow orchestration (n8n) ──────────────────────────────────────────
N8N_BASE_URL=
N8N_WEBHOOK_SECRET=

# ── AI observability (optional) ───────────────────────────────────────────
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=careeros
