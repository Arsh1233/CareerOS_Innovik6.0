# CareerOS backend environment.
# Copy to `backend/.env` and fill in real values. Never commit `.env`.
# Secrets here must NEVER be exposed to the frontend or prefixed with VITE_.
#
# Check the current state at any time (reports presence only, never values):
#     ./.venv/Scripts/python.exe scripts/preflight.py

APP_ENV=development
LOG_LEVEL=INFO

# Comma-separated list of allowed frontend origins (no wildcards).
# A browser origin that is missing here is blocked by CORS and looks exactly
# like an outage to the frontend, so keep this in sync with where you run Vite.
CORS_ALLOWED_ORIGINS=http://localhost:8443

# ── REQUIRED for auth + identity (Phase 03) ───────────────────────────────
# All four of these must be set before signup/login/profile/RLS can work.

# Project URL. Also used to fetch the JWKS that verifies access tokens.
SUPABASE_URL=https://<project-ref>.supabase.co

# Public anon key. Used for the GoTrue password grant (login) and password reset.
# Backend-only field in this app: the frontend never gets it.
SUPABASE_ANON_KEY=<anon-public-key>
# Server-side only. Grants privileged admin access — never ship to the browser.
# Needed to create accounts with a server-assigned role.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# OPTIONAL: only for legacy projects that sign JWTs with a shared HS256 secret.
# Modern projects use asymmetric signing keys, verified against the JWKS at
# {SUPABASE_URL}/auth/v1/.well-known/jwks.json — leave this empty in that case.
SUPABASE_JWT_SECRET=

# Postgres connection string used by the API (REQUIRED for Phase 03).
# The role must be able to `SET ROLE authenticated`; queries then run through
# Supabase RLS using the verified JWT claims. Use the Supabase pooler URL.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<host>:6543/postgres
DATABASE_POOL_MAX_SIZE=10

# ── AI provider (Groq) — used from later phases ───────────────────────────
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile


# ── Vector search (Qdrant) — used from later phases ───────────────────────
QDRANT_URL=
QDRANT_API_KEY=

# ── Voice (ElevenLabs) — used from later phases ───────────────────────────
ELEVENLABS_API_KEY=

# ── Workflow orchestration (n8n) ──────────────────────────────────────────
N8N_BASE_URL=
N8N_WEBHOOK_SECRET=

# ── AI observability (optional) ───────────────────────────────────────────
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=careeros
