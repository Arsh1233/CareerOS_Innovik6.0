# Frontend environment (Vite).
# Copy to `.env.local` and adjust. Only VITE_-prefixed values are exposed to the
# browser — never put backend secrets here (no service-role key, no database URL,
# no Groq/n8n secrets).

# Base URL of the CareerOS FastAPI backend.
# IMPORTANT: include the version prefix. The app appends endpoint paths such as
# `/auth/login` to this value, so it must NOT be repeated here.
VITE_API_BASE_URL=http://localhost:8000/api/v1
